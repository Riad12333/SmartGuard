# =============================================================================
# SmartGuard — Configuration LOCALE (sans Docker)
# Copiez ce fichier vers .env à la racine du projet.
# =============================================================================

# --- Base de données PostgreSQL (recommandé) ---
DATABASE_URL=postgresql+asyncpg://smartguard:smartguard_dev_password@localhost:5432/smartguard
POSTGRES_USER=smartguard
POSTGRES_PASSWORD=smartguard_dev_password
POSTGRES_DB=smartguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SQLite (fallback sans PostgreSQL) ---
# DATABASE_URL=sqlite+aiosqlite:///./smartguard.db

# --- Redis (Phase 3+, optionnel en local) ---
REDIS_URL=redis://localhost:6379/0

# --- MQTT (Phase 2+, installer Mosquitto sur Windows) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
DEBUG=true
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081,http://localhost:19000,http://127.0.0.1:8081

# --- Simulator 1 (Renault Clio — Hydra) ---
SIMULATOR_DEVICE_ID=SG-DEVICE-001
SIMULATOR_IMEI=SIMULATED-001
SIMULATOR_PUBLISH_INTERVAL_SECONDS=5
SIMULATOR_OVERSPEED_LIMIT_KMH=80

# --- Simulator 2 (Peugeot 308 — Bab Ezzouar) ---
SIMULATOR2_DEVICE_ID=SG-DEVICE-002
SIMULATOR2_IMEI=SIMULATED-002
SIMULATOR2_HOME_LATITUDE=36.7200
SIMULATOR2_HOME_LONGITUDE=3.1820
SIMULATOR2_HOME_GEOFENCE_RADIUS_M=150

# Geofence maison simulateur 1 (scénario vol)
HOME_LATITUDE=36.7525
HOME_LONGITUDE=3.0420
HOME_GEOFENCE_RADIUS_M=150

# --- Mobile (Phase 4) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000
