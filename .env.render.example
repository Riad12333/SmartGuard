# =============================================================================
# SmartGuard — Variables Render (Web Service smartguard-api)
# Copiez ces clés dans Render Dashboard → Environment
# =============================================================================

# Liée automatiquement si vous utilisez render.yaml Blueprint :
# DATABASE_URL=<fourni par Render PostgreSQL>

# Obligatoire — générez une valeur longue aléatoire :
SECRET_KEY=remplacez-par-une-cle-secrete-longue-et-aleatoire

DEBUG=false
CORS_ORIGINS=*
PYTHON_VERSION=3.12.7

# MQTT externe (optionnel — télémétrie live)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Disque persistant Starter+ uniquement :
# UPLOADS_DIR=/var/data/uploads
